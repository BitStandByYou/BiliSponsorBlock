<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/module_name"
        android:description="@string/module_description"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            设置入口只走宿主「我的」页注入的行（在宿主进程内以 Dialog 呈现），
            因此这里**不声明 LAUNCHER**，模块不出现在桌面。
            仍保留 Activity 并以 exported=true 声明，仅用于调试时用
            `am start -n io.github.bitstandbyyou.bilisb/.settings.LauncherActivity` 直接打开设置页。
        -->
        <activity
            android:name=".settings.LauncherActivity"
            android:exported="true"
            android:label="@string/module_name" />

        <provider
            android:name=".settings.SettingsProvider"
            android:authorities="${applicationId}.settings"
            android:exported="true" />
    </application>

</manifest>
